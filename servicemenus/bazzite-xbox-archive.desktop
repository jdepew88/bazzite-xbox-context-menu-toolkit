[Desktop Entry]
Type=Service
MimeType=application/x-7z-compressed;application/zip;application/x-rar;application/vnd.rar;
Actions=makeXboxArchiveXiso;
X-KDE-Priority=TopLevel

[Desktop Action makeXboxArchiveXiso]
Name=Extract Archive and Create Original Xbox XISO (for xemu)
Icon=media-optical
Exec=sh -c 'exec "$HOME/.local/lib/bazzite-xbox-context-menu-toolkit/bin/xbox-terminal-launch" archive "$1"' dummy %f
